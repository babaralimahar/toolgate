# Copy to .env for local development. Never commit .env.
ENV=dev
LOG_LEVEL=INFO

# Local compose database (docker compose up -d db)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5438/app
# Integration tests use a separate database they drop and recreate:
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5438/app_test

# LLM: "fake" costs nothing. For a real provider with an OpenAI-compatible API:
LLM_PROVIDER=fake
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=your-model-id        # must also be listed in config/pricing.yaml
# LLM_API_KEY=
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3

# Tracing: start jaeger with docker compose, then uncomment
# OTEL_ENDPOINT=http://localhost:4318/v1/traces

# off | embedded (inside the web process) | standalone (python -m app.worker)
WORKER_MODE=off


# Embeddings: fake (offline) or openai_compat (gemini-embedding-001, 768 dims)
EMBED_PROVIDER=fake
# JWT_SECRET=change-me-to-32+-random-bytes


# Downstream services (P1-P4). Credentials are ToolGate's service identities, never the clients'.
P1_URL=http://127.0.0.1:8002
# P1_API_KEY=            # LedgerLens key with clerk role
P2_URL=http://127.0.0.1:8004
# P2_TOKEN=              # PolicyPilot JWT (dev: POST /v1/dev/token)
P3_SHOP_URL=http://127.0.0.1:8006
# P3_SHOP_TOKEN=dev-shopsim-token
P4_URL=http://127.0.0.1:8007
# P4_API_KEY=            # QueryWise key with viewer role
